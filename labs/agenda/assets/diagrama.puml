@startuml
skinparam classAttributeIconSize 0

class Phone {
  + label: string
  + number: string
  + is_valid(): boolean
  + matches(pattern: string): boolean
  + toString(): string
}

class Contact {
  - name: string
  - favorite: boolean
  - phones: Array<Phone>
  + name: string {readOnly}
  + favorite: boolean {readOnly}
  + Contact(name: string)
  + add_phone(label: string, number: string): boolean
  + remove_phone(index: number): boolean
  + toggle_favorite(): void
  + matches(pattern: string): boolean
  + toString(): string
}

class Agenda {
  - contacts: Map<string, Contact>
  + Agenda()
  + add_contact(name: string): boolean
  + get_contact(name: string): Contact | null
  + remove_contact(name: string): boolean
  + search(pattern: string): Array<Contact>
  + get_favorites(): Array<Contact>
  + toString(): string
}

Agenda "1" *-- "0..*" Contact : contacts
Contact "1" *-- "0..*" Phone : phones
@enduml
