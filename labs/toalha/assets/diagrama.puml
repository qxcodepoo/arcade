@startuml

skinparam defaultFontName "Source Code Pro"
skinparam dpi 150

class Towel {
    + color: string
    + size: string
    + wetness: number
    __
    + constructor(color: string, size: string)
    + dry(amount: number): boolean
    + wringOut(): void
    + getMaxWetness(): number
    + isDry(): boolean
    + toString(): string
}
@enduml
