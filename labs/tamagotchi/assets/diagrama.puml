@startuml

skinparam defaultFontName "Source Code Pro"
skinparam dpi 150
left to right direction

enum DeathCause {
  NONE
  WEAKNESS
  DIRT
}

class Pet {
  - energyMax: number
  - cleanMax: number
  - energy: number
  - clean: number
  - age: number
  - alive: boolean
  - deathCause: DeathCause
  __
  + constructor(energyMax: number, cleanMax: number)
  + isAlive(): boolean
  + getEnergy(): number
  + getEnergyMax(): number
  + getClean(): number
  + getCleanMax(): number
  + getAge(): number
  + loseEnergy(amount: number): void
  + loseClean(amount: number): void
  + advanceAge(amount: number): void
  + restoreEnergy(): void
  + restoreClean(): void
  + toString(): string
}

class Game {
  - pet: Pet
  __
  + constructor(pet: Pet)
  + isAlive(): boolean
  + isSleepy(): boolean
  + play(): boolean
  + shower(): boolean
  + sleep(): boolean
  + toString(): string
}

Game "1" o-- "1" Pet : aggregates
Pet ..> DeathCause : records

@enduml
