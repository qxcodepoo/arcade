
@startuml

skinparam defaultFontName "Source Code Pro"
skinparam dpi 150


class Client {
  - id   : string
  - phone: string
  __
  + constructor(id : string, phone : string)
  __
  + getPhone(): string
  + setPhone(fone : string): void
  + getId(): string
  + setId(id : string): void
  __
  + toString(): string
}

class Theater {
  
  - seats : Array<Client | null>
  - search(name: string): number  
  - verifyIndex(index: number): boolean
  __
  + constructor(capacity : number)  
  __
  + reserve(id : string, phone : string, index : number) : boolean
  + cancel(id : string): void
  + getSeats() : Array<Client | null>
  __
  + toString() : string
}


Theater "1" o-- "0..*" Client
@enduml
