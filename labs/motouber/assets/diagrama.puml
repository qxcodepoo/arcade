@startuml

skinparam defaultFontName "Source Code Pro"
skinparam dpi 150
left to right direction

class Uber {
  - driver: Person | null
  - passenger: Person | null
  - runCost: number
  __
  + setDriver(driver: Person): string | null
  + setPassenger(passenger: Person): string | null
  + drive(distance: number): string | null
  + leave(): LeaveResult
  __
  + toString(): string
}

class Person {
  - name: string
  - money: number
  __
  + constructor(name: string, money: number)
  + getName(): string
  + getMoney(): number
  + setMoney(money: number): void
  + toString(): string
}

class LeaveResult {
  - passenger: Person | null
  - error: string | null
  __
  + constructor(passenger: Person | null, error: string | null)
  + getPassenger(): Person | null
  + getError(): string | null
}

Uber "1" o-- "0..1" Person : motorista
Uber "1" o-- "0..1" Person : passageiro
Uber ..> LeaveResult : retorna

note right of Uber
  Driver e passenger são referências opcionais.
  A multiplicidade 0..1 representa essa ausência.
  Métodos que retornam string podem não retornar erro.
end note

note right of LeaveResult
  passenger e error são opcionais:
  o resultado contém o passageiro removido
  ou uma mensagem de erro.
end note

@enduml
