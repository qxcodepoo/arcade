@startuml
skinparam defaultFontName "Source Code Pro"
skinparam dpi 150
left to right direction

class Phone {
  - label: string
  - number: string
  + isValid(): boolean
  + toString(): string
}

class Contact {
  - name: string
  - phones: Array<Phone>
  - starred: boolean
  + addPhone(phone: Phone): boolean
  + removePhone(index: number): boolean
  + setStarred(value: boolean): void
  + matches(pattern: string): boolean
  + toString(): string
}

class Agenda {
  - contacts: Map<string, Contact>
  - favoriteIds: Set<string>
  + addContact(contact: Contact): void
  + removeContact(name: string): boolean
  + star(name: string): boolean
  + unstar(name: string): boolean
  + getStarred(): Array<Contact>
  + search(pattern: string): Array<Contact>
  + toString(): string
}

Agenda "1" *-- "0..*" Contact : source of truth
Agenda "1" o-- "0..*" Contact : favoriteIds index
Contact "1" *-- "0..*" Phone
@enduml
