@startuml

skinparam defaultFontName "Source Code Pro"
skinparam dpi 150
left to right direction

class Notebook {
  - inUse: boolean
  - usage: number
  - battery: Bateria | null
  - charger: Charger | null
  __
  + setBattery(battery: Bateria): void
  + removeBattery(): Bateria | null
  + setCharger(charger: Charger): void
  + removeCharger(): Charger | null
  + turnOn(): string | null
  + turnOff(): void
  + use(minutes: number): string | null
}

class Bateria {
  - capacity: number
  - charge: number
  __
  + constructor(capacity: number)
  + getCapacity(): number
  + getCharge(): number
  + setCharge(value: number): void
}

class Charger {
  - power: number
  __
  + constructor(power: number)
  + getPower(): number
}

Notebook "1" o-- "0..1" Bateria : agrega
Notebook "1" o-- "0..1" Charger : agrega

note right of Notebook
  Bateria e Charger são referências opcionais.
  As multiplicidades 0..1 representam essa ausência.
  Operações de remoção podem não retornar um componente.
end note

@enduml
