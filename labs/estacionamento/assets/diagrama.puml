@startuml
skinparam classAttributeIconSize 0

abstract class Vehicle {
  # identifier: string
  # entry_time: number
  + price_for(minutes: number): number
}
class Bike
class Motorcycle
class Car
class ParkingLot {
  - current_time: number
  - vehicles: Map<string, Vehicle>
  + advance_time(minutes: number): void
  + park(vehicle: Vehicle): void
  + pay(identifier: string): string
}

Vehicle <|-- Bike
Vehicle <|-- Motorcycle
Vehicle <|-- Car
ParkingLot "1" o-- "0..*" Vehicle
@enduml
