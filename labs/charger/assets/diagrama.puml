@startuml

skinparam defaultFontName "Source Code Pro"
skinparam dpi 150
left to right direction

class Notebook {
  - inUse: boolean
  - usage: number
  - battery: Battery | null
  - charger: Charger | null
  __
  + turnOn(): boolean
  + turnOff(): void
  + use(minutes: number): UseResult
  + setBattery(battery: Battery): void
  + removeBattery(): Battery | null
  + setCharger(charger: Charger): boolean
  + removeCharger(): Charger | null
  + toString(): string
}

class Battery {
  - capacity: number
  - charge: number
  __
  + constructor(capacity: number)
  + getCapacity(): number
  + getCharge(): number
  + consume(minutes: number): boolean
  + recharge(amount: number): void
  + toString(): string
}

class Charger {
  - power: number
  __
  + constructor(power: number)
  + getPower(): number
  + toString(): string
}

enum UseResult {
  OK
  NOTEBOOK_OFF
  DISCHARGED
}

Notebook "1" o-- "0..1" Battery : aggregates
Notebook "1" o-- "0..1" Charger : aggregates
Notebook ..> UseResult : returns

note right of Notebook
  Battery and Charger are optional references.
  Their lifecycles are independent from Notebook.
end note

@enduml
