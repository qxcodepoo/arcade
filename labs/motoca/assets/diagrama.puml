@startuml

skinparam defaultFontName "Source Code Pro"
skinparam dpi 150
left to right direction

enum DriveResult {
  OK
  BUY_TIME_FIRST
  EMPTY_MOTORCYCLE
  TOO_OLD_TO_DRIVE
  TIME_FINISHED
}

class Motorcycle {
  - person: Person | null
  - size : number
  - time  : number
  __
  + constructor(size: number)
  + enter(person: Person): boolean
  + leave(): Person | null
  __
  + buy(time : number): void
  + drive(time : number): DriveResult
  __
  + getPerson(): Person | null
  + getSize()  : number
  + getTime()  : number
  __
  + toString(): string
}
  
class Person {
  - age : number
  - name: string
  __
  + constructor(name: string, age: number)
  __
  + canDrive(maxAge: number): boolean
  + getAge() : number
  + getName(): string
  __
  + toString(): string
}

Motorcycle "1" o-- "0..1" Person : aggregates
Motorcycle ..> DriveResult : returns

note right of Motorcycle
  A moto pode não ter uma pessoa agregada.
  A multiplicidade 0..1 representa essa ausência.
  leave() e getPerson() podem não retornar uma pessoa.
end note
@enduml
